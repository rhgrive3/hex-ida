+  view.setUint16(52, 64, true);
+  if (!loaded) view.setUint16(54, 56, true);
+  view.setUint16(58, sectionHeaderSize, true);
+  view.setUint16(60, sectionCount, true);
+  view.setUint16(62, 5, true);
