+  const at = (rva) => FILE_OFFSET + (rva - SECTION_RVA);
+  writeU32(bytes, at(PDATA_RVA), BEGIN_RVA);
+  writeU32(bytes, at(PDATA_RVA) + 4, XDATA_RVA);
