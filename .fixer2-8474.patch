+  return (
+    4 |
+    (packedEpilog ? (1 << 21) : 0) |
+    ((epilogCount & 0x1f) << 22) |
+    ((codeWords & 0x1f) << 27)
+  ) >>> 0;
+}
+
+function scopeWord(epilogStartIndex, startOffset = 0) {
+  return (((epilogStartIndex & 0x3ff) << 22) | (startOffset & 0x3ffff)) >>> 0;
+}
