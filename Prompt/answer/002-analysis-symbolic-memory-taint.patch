+      beforeValueId:candidate.beforeValueId,afterValueId:candidate.afterValueId,
+      beforeHash:hashes.hashes[0],afterHash:hashes.hashes[1],preconditionHashes:Object.freeze(hashes.hashes.slice(2)),
