--- /dev/null
+++ b/js/symbolic/taint/lattice.js
@@ -0,0 +1,27 @@
+/** Finite source-set lattice: bottom (untainted), finite sets, and explicit TOP. */
+export const UNTAINTED=Object.freeze({kind:'untainted',sources:Object.freeze([])});
+export const TAINT_TOP=Object.freeze({kind:'top',sources:Object.freeze([])});
+export function sourceTaint(source) {
+  if(typeof source!=='string'||!source) throw new TypeError('taint source ID required');
+  return Object.freeze({kind:'sources',sources:Object.freeze([source])});
+}
+export function joinTaint(a,b,maxSources=4096) {
