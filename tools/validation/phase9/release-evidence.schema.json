{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase9ReleaseEvidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "phase",
    "verdict",
    "verifier",
    "product",
    "backend",
    "testExecution",
    "browserRuntime",
    "solverMetrics",
    "physicalDeviceEvidence",
    "gates",
    "deterministicDigest",
    "capabilities",
    "evidenceDigest"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "phase9-release-evidence/v4" },
    "phase": { "type": "integer", "const": 9 },
    "verdict": { "type": "string", "enum": ["READY", "BLOCKING", "NOT-INTEGRATED"] },
    "verifier": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "product": {
      "type": "object",
      "required": ["commitSha", "treeSha", "clean"],
      "properties": {
        "commitSha": { "type": "string" },
        "treeSha": { "type": "string" },
        "clean": { "type": "boolean" },
        "dirtyFiles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "backend": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "proofAuthority": { "type": "string", "enum": ["none", "test-only", "heuristic", "exact"] },
        "capabilityFingerprint": { "type": "string" }
      }
    },
    "testExecution": {
      "type": "object",
      "required": ["selected", "total", "allPassed"],
      "properties": {
        "selected": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "allPassed": { "type": "boolean" }
      }
    },
    "browserRuntime": {
      "type": "object",
      "required": ["selected", "total", "allPassed", "engines"],
      "properties": {
        "selected": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "allPassed": { "type": "boolean" },
        "engines": { "type": "array", "items": { "type": "object" } }
      }
    },
    "solverMetrics": { "type": ["object", "null"] },
    "physicalDeviceEvidence": {
      "type": "object",
      "required": ["state", "verified", "deviceModel", "osVersion", "browserVersion", "commitSha", "treeSha", "checks"],
      "properties": {
        "state": { "type": "string", "enum": ["absent", "invalid", "verified"] },
        "verified": { "type": "boolean" },
        "deviceModel": { "type": ["string", "null"] },
        "osVersion": { "type": ["string", "null"] },
        "browserVersion": { "type": ["string", "null"] },
        "commitSha": { "type": ["string", "null"] },
        "treeSha": { "type": ["string", "null"] },
        "checks": { "type": "object" }
      }
    },
    "gates": { "type": "array", "items": { "type": "object", "required": ["id", "status", "ok"] } },
    "deterministicDigest": { "type": "string" },
    "capabilities": { "type": "object" },
    "evidenceDigest": { "type": "string" }
  },
  "additionalProperties": true
}
