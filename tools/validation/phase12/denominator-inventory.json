          "check": {
            "type": "source-includes",
            "path": "js/collaboration/index.js",
            "markers": [
              "type: 'stale-precondition'",
              "type: 'meaningful-conflict'",
              "reason: 'tombstone-protects-state'",
              "reason: 'stale-before-fingerprint'",
              "reason: 'missing-causal-parent'"
            ]
          }
        },
        {
          "id": "remote.gate.supported-schema-fallbacks",
          "classification": "EXACT",
          "check": {
            "type": "source-includes",
            "path": "js/collaboration/remote-authority.js",
            "markers": [
              "input.supportedEnvelopeSchemas || [REMOTE_COLLAB_SCHEMA]",
              "input.supportedOperationSchemas || [CHANGELOG_SCHEMA_VERSION]"
            ]
          }
        },
        {
          "id": "remote.security.transport-proof-classes",
          "classification": "EXACT",
          "check": {
            "type": "source-includes",
            "path": "js/collaboration/remote-authority.js",
            "markers": [
              "authenticated: input.transportProof?.authenticated === true",
              "confidentiality: input.transportProof?.confidentiality === 'verified' ? 'verified' : 'unverified'",
              "integrity: input.transportProof?.integrity === 'verified' ? 'verified' : 'unverified'",
              "remote-transport-security-unverified",
              "remote-transport-proof-rejected"
            ]
          }
        },
        {
          "id": "remote.security.egress-classes",
          "classification": "EXACT",
          "check": {
            "type": "source-includes",
            "path": "js/collaboration/remote-authority.js",
            "markers": [
              "userAuthorized: input.egress?.userAuthorized === true",
              "rawBinaryBytes: input.egress?.rawBinaryBytes === true",
              "derivedDataOnly: input.egress?.derivedDataOnly !== false",
              "remote-egress-user-authorization-required",
              "remote-raw-binary-egress-forbidden"
            ]
          }
        },
        {
          "id": "remote.security.rejection-classes",
          "classification": "EXACT",
          "check": {
            "type": "source-collection",
            "path": "js/collaboration/remote-authority.js",
            "start": "validate(envelope) {",
            "end": "\n  }\n\n  accept(envelope)",
            "regex": "reason: '([^']+)'",
            "expected": [
              "remote-envelope-schema-unsupported",
              "remote-operation-schema-unsupported",
              "remote-wrong-project",
              "remote-wrong-binary",
              "remote-wrong-session",
              "remote-sequence-invalid",
              "remote-envelope-identity-mismatch",
              "remote-actor-revoked",
              "remote-actor-unauthorized",
              "remote-replay-or-duplicate",
              "remote-stale-sequence",
              "remote-batch-budget-exceeded",
              "remote-message-budget-exceeded",
              "remote-transport-security-unverified",
              "remote-transport-proof-rejected",
              "remote-egress-user-authorization-required",
              "remote-raw-binary-egress-forbidden",
              "remote-operation-scope-mismatch",
              "remote-operation-actor-binding-mismatch",
              "remote-operation-provenance-invalid",
              "remote-operation-not-authorized"
            ]
          }
        },
        {
          "id": "remote.delivery-result-classes",
          "classification": "EXACT",
          "check": {
            "type": "source-includes",
            "path": "js/collaboration/remote-delivery.js",
            "markers": [
              "status: 'rejected'",
              "status: unresolvedOperationIds.length ? 'accepted-with-pending-dependencies' : 'applied'",
              "unresolvedOperationIds"
            ]
          }
        },
        {
          "id": "remote.behavior.operation-and-conflict-classes",
          "classification": "EXACT",
          "check": {
            "type": "behavior",
            "id": "remote-operation-classes",
            "expected": ["applied", "duplicate", "conflict", "unresolved", "rejected", "tombstone"]
          }
        },
        {
          "id": "remote.behavior.security-gate",
          "classification": "EXACT",
          "check": {
            "type": "behavior",
            "id": "remote-security-gate",
            "expected": ["default-unverified-rejected", "secure-authorized-accepted", "replay-rejected", "raw-egress-rejected"]
          }
        },
        {
          "id": "remote.remote-canonical-transport",
          "classification": "BLOCKING_GAP",
          "reason": "Remote canonical transport has no exact security-profile proof at this head; the missing replay, identity, authorization, transport, privacy, convergence, revocation, and out-of-order evidence blocks closure.",
          "gapKind": "PROOF_ABSENCE",
          "requiredProof": [
            "exactHead",
            "replayTests",
            "identityTests",
            "authorizationTests",
            "transportSecurityTests",
            "privacyTests",
            "convergenceTests",
            "revocationTests",
            "outOfOrderTests"
          ],
          "check": {
            "type": "all",
            "checks": [
              {
                "type": "source-includes",
                "path": "js/collaboration/remote-authority.js",
                "markers": [
                  "status: ready ? 'supported-for-exact-security-profile' : 'unsupported'",
                  "proof.exactHead === true",
                  "proof.replayTests === true",
                  "proof.identityTests === true",
                  "proof.authorizationTests === true",
                  "proof.transportSecurityTests === true",
                  "proof.privacyTests === true",
                  "proof.convergenceTests === true",
                  "proof.revocationTests === true",
                  "proof.outOfOrderTests === true"
                ]
              },
              {
                "type": "behavior",
                "id": "remote-canonical-transport",
                "expected": ["unsupported-without-profile-proof"]
              }
            ]
          }
        },
        {
          "id": "remote.derived-analysis-egress",
          "classification": "PREEXISTING_NORMATIVE_EXCLUSION",
          "reason": "Derived analysis is excluded from the current remote canonical collaboration claim; only explicitly authorized derived-data-only egress may pass the gate.",
          "check": {
            "type": "truth-entry",
            "module": "js/platform/capability-maturity.js",
            "export": "phase12Maturity",
            "path": "collaboration.limitations",
